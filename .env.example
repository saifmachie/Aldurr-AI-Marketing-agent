ANTHROPIC_API_KEY=
# Optional overrides — defaults chosen per the spec's suggested assignments,
# subject to the bake-off in AlDurrAgentArchitecture.md §5.
STRATEGIST_MODEL=claude-opus-5
COPYWRITER_MODEL=claude-sonnet-5
COMPLIANCE_MODEL=claude-haiku-4-5-20251001

# Test mode — set LLM_PROVIDER=gemini to route every agent through Google's
# free tier instead of Claude, e.g. to test the pipeline's mechanics without
# spending API credits. Get a free key at ai.google.dev. Dialect quality
# will not match Claude — this is a plumbing test, not a copy preview.
LLM_PROVIDER=anthropic
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Designer agent — Canva Connect API. Requires a Canva Pro/Teams/Enterprise
# plan for brand-template autofill. Obtain via Canva's Developer Portal
# OAuth flow (see https://www.canva.dev/docs/connect/).
CANVA_ACCESS_TOKEN=

# Publisher agent — Meta Graph API. Requires a Facebook Page, a linked
# Instagram Business account, a Meta Developer App, and (for anything beyond
# your own test users) App Review approval for pages_manage_posts and
# instagram_content_publish. Until these are set, the publisher skips
# gracefully and content is posted manually.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
